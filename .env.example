# ──────────────────────────────────────────────
# Bingooo — Environment Variables
# Copy to .env and fill in real values.
# NEVER commit .env to source control.
# ──────────────────────────────────────────────

# ── Frontend (VITE_ prefix = exposed to browser) ──
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_RAZORPAY_KEY_ID=
# Local-only development admin access. Keep false in every deployed frontend.
VITE_ENABLE_DEV_AUTH=false

# ── Backend ──
NODE_ENV=development
PORT=3000

# Supabase
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Durable storage. "supabase" persists all data to the app_records table
# (run supabase/migrations/004_app_records.sql first). Leave empty locally so
# development never reads or writes production data.
DATA_STORE=

# Comma-separated emails granted SUPER_ADMIN when they sign in via Supabase
# with a confirmed email address. Required to reach the admin panel.
ADMIN_EMAILS=

# Explicit local-only development admin access. Never enable in production.
ENABLE_DEV_AUTH=false

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Vercel Deploy Hook for the storefront. When set, product/category changes in the
# admin panel trigger a rebuild (batched, ~5 min) so new products get crawlable
# pages, sitemap entries and Google Merchant feed items.
VERCEL_DEPLOY_HOOK_URL=

# Resend transactional email (order confirmations, password resets).
# The sender domain must be verified at https://resend.com/domains.
RESEND_API_KEY=
EMAIL_FROM=BINGOOO. <noreply@bingooo.co.in>

# WhatsApp order confirmation (sent once, after payment is captured). Optional.
# Option 1, Meta WhatsApp Cloud API: needs an approved template whose body has
# {{1}} customer name, {{2}} order number, {{3}} amount paid, {{4}} tracking link.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ORDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# Option 2, provider webhook (AiSensy, Interakt, WATI, Zapier...). Receives JSON
# {event, to, customerName, orderNumber, amount, trackingUrl, message}; signed
# with HMAC-SHA256 in X-Bingooo-Signature when the secret is set.
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bingooo-public
R2_PUBLIC_BASE_URL=

# Application
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Monitoring
SENTRY_DSN=
