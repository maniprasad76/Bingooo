{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/v1/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/v1/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:file([^/]+\\.(?:jpg|jpeg|png|webp|avif|svg|ico))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; object-src 'none'; base-uri 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://vercel.live; font-src 'self' data: https://fonts.gstatic.com https://vercel.live https://assets.vercel.com; img-src 'self' data: blob: https:; worker-src 'self' blob:; manifest-src 'self'; script-src 'self' 'unsafe-inline' https://checkout.razorpay.com https://cdn.razorpay.com https://va.vercel-scripts.com https://vercel.live https://www.googletagmanager.com; connect-src 'self' https://api.bingooo.co.in https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://zqmrmgwxhrdscippanuv.supabase.co wss://zqmrmgwxhrdscippanuv.supabase.co https://*.razorpay.com https://*.vercel-insights.com https://vercel.live wss://ws-us3.pusher.com; frame-src https://api.razorpay.com https://checkout.razorpay.com https://*.razorpay.com https://www.youtube.com https://www.youtube-nocookie.com https://www.google.com https://maps.google.com https://vercel.live; form-action 'self' https://*.razorpay.com; frame-ancestors 'self'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/about-us",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/shipping",
      "destination": "/shipping-policy",
      "permanent": true
    },
    {
      "source": "/returns",
      "destination": "/returns-refunds",
      "permanent": true
    },
    {
      "source": "/return-policy",
      "destination": "/returns-refunds",
      "permanent": true
    },
    {
      "source": "/cancellation",
      "destination": "/cancellation-policy",
      "permanent": true
    },
    {
      "source": "/fabric-specifications",
      "destination": "/fabric-guide",
      "permanent": true
    },
    {
      "source": "/track",
      "destination": "/track-order",
      "permanent": true
    },
    {
      "source": "/account/wishlist",
      "destination": "/wishlist",
      "permanent": true
    },
    {
      "source": "/empty",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/empty-state",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/policies/size-guide",
      "destination": "/size-guide",
      "permanent": true
    },
    {
      "source": "/policies/shipping(.*)",
      "destination": "/shipping-policy",
      "permanent": true
    },
    {
      "source": "/policies/return(.*)",
      "destination": "/returns-refunds",
      "permanent": true
    },
    {
      "source": "/policies/privacy(.*)",
      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/policies/terms(.*)",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/policies/cancellation(.*)",
      "destination": "/cancellation-policy",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://api.bingooo.co.in/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ]
}
