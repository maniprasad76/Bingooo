{
  "name": "bingooo-motion",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Ad out/bingooo-ad.mp4 --codec=h264 --crf=16",
    "render:real": "remotion render src/index.ts Real out/bingooo-realistic.mp4 --codec=h264 --crf=17",
    "render:real-long": "remotion render src/index.ts RealLong out/bingooo-realistic-33s.mp4 --codec=h264 --crf=19",
    "render:real-feed": "remotion render src/index.ts RealLongFeed out/bingooo-realistic-33s-4x5.mp4 --codec=h264 --crf=19",
    "render:real-square": "remotion render src/index.ts RealLongSquare out/bingooo-realistic-33s-1x1.mp4 --codec=h264 --crf=19"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@remotion/cli": "^4.0.534",
    "@remotion/media": "^4.0.534",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.534",
    "typescript": "^7.0.2"
  }
}
